# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://justin:justin@localhost:5432/justin
ADMIN_PASSWORD=
CRON_SECRET=                      # Vercel Cron sends this as a Bearer token
CRAWL_USER_AGENT="JustinPilot/0.1 (Utah Area JustServe pilot; contact: <your email>)"

# Models (defaults shown). Tagging/parsing uses a small fast model; chat uses a stronger one.
FAST_MODEL=claude-haiku-4-5
CHAT_MODEL=claude-opus-5

# Later (Supabase/Vercel deploy): SUPABASE_URL, SUPABASE_SERVICE_KEY, EMBEDDING_API_KEY
